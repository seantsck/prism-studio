{
  "name": "prism-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Prism Studio — AI filmmaking production operating system",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:inspect": "node --env-file=.env.local scripts/db-inspect.mjs",
    "db:migrate": "node --env-file=.env.local scripts/db-migrate.mjs",
    "db:validate": "node --env-file=.env.local scripts/db-validate.mjs",
    "db:behavior": "node --env-file=.env.local scripts/db-behavior.mjs",
    "db:create-dev-user": "node --env-file=.env.local scripts/create-dev-user.mjs",
    "db:seed": "tsx --env-file=.env.local scripts/db-seed.mts",
    "db:exercise": "tsx --env-file=.env.local scripts/db-exercise.mts",
    "test:e2e:supabase": "playwright test -c playwright.supabase.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.552.0",
    "next": "^16.4.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
