{
  "name": "prism-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Prism Studio — AI filmmaking production operating system",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:inspect": "node --env-file=.env.local scripts/db-inspect.mjs",
    "db:migrate": "node --env-file=.env.local scripts/db-migrate.mjs",
    "db:migrate:check": "node --env-file=.env.local scripts/db-migrate.mjs --check",
    "db:migrate:dry-run-check": "node --env-file=.env.local scripts/db-migrate-dry-run-check.mjs",
    "db:validate": "node --env-file=.env.local scripts/db-validate.mjs",
    "db:behavior": "node --env-file=.env.local scripts/db-behavior.mjs",
    "db:seed": "tsx --env-file=.env.local scripts/db-seed.mts",
    "db:storage:setup": "node --env-file=.env.local scripts/db-storage-setup.mjs",
    "db:storage:smoke": "node --env-file=.env.local scripts/db-storage-smoke.mjs",
    "db:rls": "tsx --env-file=.env.local scripts/db-rls.mts",
    "db:exercise": "tsx --env-file=.env.local scripts/db-exercise.mts",
    "test:e2e:supabase": "playwright test -c playwright.supabase.config.ts",
    "worker:generation": "tsx --env-file=.env.local scripts/generation-worker.mts",
    "db:generation": "tsx --env-file=.env.local scripts/db-generation.mts",
    "db:generation:cleanup": "tsx --env-file=.env.local scripts/generation-cleanup.mts",
    "worker:db:provision": "tsx --env-file=.env.local scripts/worker-db-provision.mts",
    "worker:db:check": "tsx --env-file=.env.local scripts/worker-db-check.mts",
    "db:worker-role": "tsx --env-file=.env.local scripts/db-worker-role.mts",
    "db:media-qa": "tsx --env-file=.env.local scripts/db-media-qa.mts",
    "continuity:db:provision": "tsx --env-file=.env.local scripts/continuity-db-provision.mts",
    "db:candidates": "tsx --env-file=.env.local scripts/db-candidates.mts",
    "db:previs": "tsx --env-file=.env.local scripts/db-previs.mts",
    "db:blocking": "tsx --env-file=.env.local scripts/db-blocking.mts",
    "db:spatial-passes": "tsx --env-file=.env.local scripts/db-spatial-passes.mts",
    "db:reconstructions": "tsx --env-file=.env.local scripts/db-reconstructions.mts",
    "db:reconstruction-jobs": "tsx --env-file=.env.local scripts/db-reconstruction-jobs.mts",
    "db:local-worker": "tsx --env-file=.env.local scripts/db-local-worker.mts",
    "local:verify-colmap": "tsx scripts/local-verify-colmap.mts",
    "local:reconstruction-worker": "tsx --env-file=.env.local scripts/run-local-reconstruction-worker.mts",
    "local:agent": "tsx scripts/local-agent.mts",
    "local:acceptance:check": "tsx --env-file-if-exists=.env.local scripts/reconstruction-acceptance.mts check",
    "local:acceptance:smoke": "tsx scripts/reconstruction-acceptance.mts smoke",
    "local:acceptance:room": "tsx scripts/reconstruction-acceptance.mts room",
    "local:acceptance:render": "tsx scripts/reconstruction-acceptance.mts render",
    "local:acceptance:verdict": "tsx scripts/reconstruction-acceptance.mts verdict",
    "db:local-agents": "tsx --env-file=.env.local scripts/db-local-agents.mts",
    "db:remote-agent-jobs": "tsx --env-file=.env.local scripts/db-remote-agent-jobs.mts",
    "db:production-frames": "tsx --env-file=.env.local scripts/db-production-frames.mts",
    "db:image-shot-generator": "tsx --env-file=.env.local scripts/db-image-shot-generator.mts",
    "db:location-views": "tsx --env-file=.env.local scripts/db-location-views.mts",
    "db:character-continuity": "tsx --env-file=.env.local scripts/db-character-continuity.mts",
    "db:episode-edits": "tsx --env-file=.env.local scripts/db-episode-edits.mts",
    "db:continuity-analysis": "tsx --env-file=.env.local scripts/db-continuity-analysis.mts",
    "db:sequence-continuity": "tsx --env-file=.env.local scripts/db-sequence-continuity.mts",
    "db:disposable": "node --env-file=.env.disposable scripts/db-disposable.mjs",
    "continuity:worker": "tsx --env-file=.env.local scripts/continuity-worker.mts",
    "continuity:pre-paid:check": "tsx --env-file=.env.local scripts/continuity-pre-paid-check.mts",
    "continuity:temporal:calibrate": "tsx --env-file=.env.local scripts/continuity-temporal-calibration.mts",
    "continuity:temporal:smoke": "tsx --env-file=.env.local scripts/continuity-temporal-smoke.mts",
    "continuity:sequence:calibrate": "tsx --env-file=.env.local scripts/continuity-sequence-calibration.mts",
    "continuity:sequence:smoke": "tsx --env-file=.env.local scripts/continuity-sequence-smoke.mts",
    "continuity:pre-paid:check:openai": "tsx --env-file=.env.local scripts/continuity-pre-paid-check.mts --provider openai",
    "continuity:run:report": "tsx --env-file=.env.local scripts/continuity-run-report.mts",
    "continuity:fixture": "tsx --env-file=.env.local scripts/continuity-smoke-fixture.mts",
    "pre-paid:check": "tsx --env-file=.env.local scripts/pre-paid-check.mts",
    "runway:fixture": "tsx --env-file=.env.local scripts/runway-smoke-fixture.mts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "2.29.0",
    "@runwayml/sdk": "4.22.0",
    "@sparkjsdev/spark": "0.1.10",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "audio-decode": "^3.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "0.8.3",
    "lucide-react": "^0.552.0",
    "mediabunny": "1.60.0",
    "music-metadata": "^12.1.1",
    "next": "^16.4.1",
    "openai": "7.32.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "three": "^0.171.0",
    "zod": "^4.6.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.171.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
