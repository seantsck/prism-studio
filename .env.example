# Copy to .env.local (git-ignored). Names only: NEVER commit real values.
#
# Project: Prism Studio's dedicated Supabase project (ref lyqdxiyjperhniwhzsvg). Every script and the app refuse to
# connect when these point at any other project.

# ── Public (safe in the browser; useless without a user session + RLS) ──
NEXT_PUBLIC_SUPABASE_URL=https://lyqdxiyjperhniwhzsvg.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Origin of THIS app, used for auth email redirects. Prism Engine owns :3000; Prism Studio uses :3100.
# Production: https://studio.prismsuite.io
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# ── Server only ──
# Session-pooler connection string (IPv4). Contains the DB password: never log or commit.
SUPABASE_DB_URL=

# memory   = in-process demo data, no accounts (default; tests, demos)
# supabase = Postgres + real Supabase Auth + Storage, RLS enforced per request
PRISM_STUDIO_PERSISTENCE=memory

# ── Scripts / tests ONLY (the running app never reads these) ──
# Supabase Auth user UUID that owns seeded data. NOT an email address.
PRISM_STUDIO_DEV_USER_ID=
# The ONE local Prism Studio identity (email + password of that same Auth user). Used for manual login,
# Playwright / Supabase E2E, acceptance checks and local smoke tests. There is no separate test account and
# no fallback chain: tooling that needs a signed-in user requires both variables and fails clearly without them.
PRISM_STUDIO_DEV_USER_EMAIL=
PRISM_STUDIO_DEV_USER_PASSWORD=

# ── Generation (Phase 2A) ──
# Providers enabled in this deployment (comma list). "mock" is on by default outside production.
# PRISM_STUDIO_GENERATION_PROVIDERS=mock
# Production builds only: allow the free Mock provider.
# PRISM_STUDIO_ENABLE_MOCK_PROVIDER=1
# Per-provider credentials (names only; set values in the SERVER / WORKER environment, never commit):
#   PRISM_STUDIO_PROVIDER_<PROVIDER_ID>_API_KEY=
# Limits (defaults shown)
# PRISM_STUDIO_GENERATION_MAX_ACTIVE_PER_PROJECT=3
# PRISM_STUDIO_GENERATION_MAX_SUBMITS_PER_MINUTE=10
# PRISM_STUDIO_GENERATION_MAX_ATTEMPTS=4
# PRISM_STUDIO_GENERATION_MAX_DOWNLOAD_BYTES=52428800
# Worker tuning
# PRISM_STUDIO_WORKER_CONCURRENCY=2
# PRISM_STUDIO_WORKER_LEASE_MS=60000
# Memory/demo mode runs the worker in-process; set 0 to disable.
# PRISM_STUDIO_INLINE_WORKER=1
# ── Generation worker (Phase 2B) — WORKER HOST ONLY: never the Next.js app, never the browser, never logged ──
# Least-privilege Postgres role (migration 0015). Provision with `npm run worker:db:provision`, then set the
# SESSION POOLER connection string for login `prism_generation_worker.<project ref>`. Required: the worker
# never falls back to SUPABASE_DB_URL.
PRISM_STUDIO_WORKER_DB_URL=
# Only read by `npm run worker:db:provision` (a generated secret of 24+ characters):
PRISM_STUDIO_WORKER_DB_PASSWORD=
# Private Storage write access for the worker: a Supabase SECRET key. Preferred name first; the legacy name is
# a compatibility fallback. Neither is ever NEXT_PUBLIC_.
PRISM_STUDIO_WORKER_SUPABASE_SECRET_KEY=
PRISM_STUDIO_WORKER_SERVICE_KEY=
# Development only (explicit opt-ins; refused when NODE_ENV=production):
# PRISM_STUDIO_WORKER_DEV_ASSUME_ROLE=1   # admin connection + SET ROLE prism_generation_worker
# PRISM_STUDIO_WORKER_DEV_STORAGE=1       # sign in as the test user instead of a secret key

# ── Providers ──
# Runway (Gen-4.5). Credential is server/worker only. Enable with PRISM_STUDIO_GENERATION_PROVIDERS=runway.
RUNWAYML_API_SECRET=
# PRISM_STUDIO_RUNWAY_MAX_CONCURRENCY=1        # match your Runway usage tier
# PRISM_STUDIO_RUNWAY_OUTPUT_HOSTS=            # extra output CDN hosts (exact or *.suffix), comma separated

# ── LIVE-SPEND GATE: a configured API key is NOT permission to spend ──
# Billing models are refused unless paid generation is enabled AND the estimate is within the limit.
PRISM_STUDIO_ALLOW_PAID_GENERATION=false
# Per-generation ceiling in USD. Unset/invalid = no ceiling = paid generation stays blocked.
PRISM_STUDIO_MAX_GENERATION_USD=
# Phase 2E candidate sets (several paid generations submitted as ONE explicit experiment). SERVER values only.
# Maximum total estimated USD of one set. Unset/invalid = paid candidate sets stay blocked.
PRISM_STUDIO_MAX_CANDIDATE_SET_USD=
# Candidates per set (1..8, default 6).
# PRISM_STUDIO_MAX_CANDIDATES_PER_SET=6

# The web application uses NO service-role / secret key: it works with the publishable key + a user session
# (application) or the database connection string (maintenance scripts).

# ── Phase 2C: delivery conform + continuity QA (app server; optional) ──
# ffmpeg/ffprobe must be on PATH for "Create delivery conform" and review frames/contact sheets. Everything else
# works without them (the UI says media processing is unavailable).
# PRISM_STUDIO_FFMPEG_PATH=ffmpeg
# PRISM_STUDIO_FFPROBE_PATH=ffprobe
# Set to "none" to run only the deterministic continuity checks (no Mock analyzer).
# PRISM_STUDIO_CONTINUITY_ANALYZER=mock

# ── Phase 2D: continuity ANALYSIS (real multimodal analyzer, queued; free mock is always available) ──
# Which analyzers are enabled (comma separated): mock, gemini, openai. A configured key is NOT permission to spend
# and does not enable a provider: it must be listed here.
# PRISM_STUDIO_CONTINUITY_ANALYZERS=mock
# Gemini (official @google/genai). Server/worker ONLY: never NEXT_PUBLIC_, never in a job, log or manifest.
GEMINI_API_KEY=
# PRISM_STUDIO_GEMINI_ANALYSIS_MODEL=gemini-3.8-flash
# PRISM_STUDIO_GEMINI_THINKING_LEVEL=LOW
# Direct-video analysis exists architecturally but is OFF unless this is 1 (no live use in Phase 2D).
# PRISM_STUDIO_GEMINI_DIRECT_VIDEO=0
# OpenAI (official `openai` SDK, Responses API). Server/worker ONLY: never NEXT_PUBLIC_, never in a job, log or manifest.
OPENAI_API_KEY=
# PRISM_STUDIO_OPENAI_ANALYSIS_MODEL=gpt-6-luna
# PRISM_STUDIO_OPENAI_REASONING_EFFORT=low
# PRISM_STUDIO_OPENAI_TIMEOUT_MS=120000
# ANALYSIS spend gate: separate from PRISM_STUDIO_ALLOW_PAID_GENERATION. Shared by every analyzer.
PRISM_STUDIO_ALLOW_PAID_ANALYSIS=false
# Server-side ceilings in USD (a number from the browser is never trusted). Unset = paid analysis blocked.
PRISM_STUDIO_MAX_ANALYSIS_USD_PER_RUN=
# PRISM_STUDIO_MAX_ANALYSIS_USD_PER_DAY=
# PRISM_STUDIO_ANALYSIS_MAX_ACTIVE_PER_PROJECT=3
# PRISM_STUDIO_ANALYSIS_MAX_ATTEMPTS=6   (worker claims per job; overload retries are durable, one request per claim)
# PRISM_STUDIO_ANALYSIS_MAX_TRANSPORT_CALLS=6   (hard ceiling on provider requests per run, corrections included)
# PRISM_STUDIO_ANALYSIS_MAX_CORRECTIONS=1   (schema-correction requests per run)
# The continuity worker's least-privilege database login (npm run continuity:db:provision), worker host ONLY.
PRISM_STUDIO_CONTINUITY_DB_URL=
PRISM_STUDIO_CONTINUITY_DB_PASSWORD=

# ── Reconstruction jobs (Phase 2F M2D.2): reference images -> spatial environment ──
# Nothing is ever submitted unless ALL of: the feature flag, the provider flag + its key, and the live-spend gate above
# (PRISM_STUDIO_ALLOW_PAID_GENERATION=true with PRISM_STUDIO_MAX_GENERATION_USD covering the documented price).
PRISM_RECONSTRUCTION_JOBS_ENABLED=false
# minimum milliseconds between two provider polls of one job (default 5000)
# PRISM_RECONSTRUCTION_POLL_MS=5000
# World Labs Marble (https://docs.worldlabs.ai). Server-only; never exposed to the browser, never logged.
WORLDLABS_RECONSTRUCTION_ENABLED=false
WLT_API_KEY=
# WLT_API_BASE_URL=https://api.worldlabs.ai
# hosts the signed upload / result URLs may use (SSRF allow-lists)
# WLT_UPLOAD_HOSTS=storage.googleapis.com
# WLT_RESULT_HOSTS=*.worldlabs.ai,wlt-ai-cdn.art,storage.googleapis.com
# Free deterministic mock provider: always available in development; production builds only with this flag (E2E).
# PRISM_STUDIO_ENABLE_MOCK_RECONSTRUCTION=1
# PRISM_STUDIO_MOCK_RECONSTRUCTION_MS=8000
