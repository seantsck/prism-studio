# Copy to .env.local (git-ignored). Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Session pooler connection string (IPv4). Server-side only.
SUPABASE_DB_URL=
# memory (default, demo seed) | supabase (dedicated Prism Studio project only)
PRISM_STUDIO_PERSISTENCE=memory
# Real Supabase Auth user that owns local data (created via `npm run db:create-dev-user` or the dashboard)
PRISM_STUDIO_DEV_USER_ID=
