# Copy to .env.local (git-ignored). Names only: NEVER commit real values.
#
# Project: Prism Studio's dedicated Supabase project (ref lyqdxiyjperhniwhzsvg). Every script and the app refuse to
# connect when these point at any other project.

# ── Public (safe in the browser; useless without a user session + RLS) ──
NEXT_PUBLIC_SUPABASE_URL=https://lyqdxiyjperhniwhzsvg.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Origin of THIS app, used for auth email redirects. Prism Engine owns :3000; Prism Studio uses :3100.
# Production: https://studio.prismsuite.io
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# ── Server only ──
# Session-pooler connection string (IPv4). Contains the DB password: never log or commit.
SUPABASE_DB_URL=

# memory   = in-process demo data, no accounts (default; tests, demos)
# supabase = Postgres + real Supabase Auth + Storage, RLS enforced per request
PRISM_STUDIO_PERSISTENCE=memory

# ── Scripts / tests ONLY (the running app never reads these) ──
# Supabase Auth user UUID that owns seeded data. NOT an email address.
PRISM_STUDIO_DEV_USER_ID=
# Optional cross-check: must match the Auth user's email when set.
PRISM_STUDIO_DEV_USER_EMAIL=
# Playwright signed-in flow (npm run test:e2e:supabase). Skipped when the password is empty.
# PRISM_STUDIO_TEST_EMAIL defaults to PRISM_STUDIO_DEV_USER_EMAIL.
PRISM_STUDIO_TEST_EMAIL=
PRISM_STUDIO_TEST_PASSWORD=

# ── Generation (Phase 2A) ──
# Providers enabled in this deployment (comma list). "mock" is on by default outside production.
# PRISM_STUDIO_GENERATION_PROVIDERS=mock
# Production builds only: allow the free Mock provider.
# PRISM_STUDIO_ENABLE_MOCK_PROVIDER=1
# Per-provider credentials (names only; set values in the SERVER / WORKER environment, never commit):
#   PRISM_STUDIO_PROVIDER_<PROVIDER_ID>_API_KEY=
# Limits (defaults shown)
# PRISM_STUDIO_GENERATION_MAX_ACTIVE_PER_PROJECT=3
# PRISM_STUDIO_GENERATION_MAX_SUBMITS_PER_MINUTE=10
# PRISM_STUDIO_GENERATION_MAX_ATTEMPTS=4
# PRISM_STUDIO_GENERATION_MAX_DOWNLOAD_BYTES=52428800
# Worker tuning
# PRISM_STUDIO_WORKER_CONCURRENCY=2
# PRISM_STUDIO_WORKER_LEASE_MS=60000
# Memory/demo mode runs the worker in-process; set 0 to disable.
# PRISM_STUDIO_INLINE_WORKER=1
# WORKER ONLY (never the Next.js app, never the browser): lets the worker write generated files to the
# private Storage bucket. Without it the worker falls back to the dev test credentials (non-production only).
# PRISM_STUDIO_WORKER_SERVICE_KEY=

# The web application uses NO service-role / secret key: it works with the publishable key + a user session
# (application) or the database connection string (maintenance scripts).
