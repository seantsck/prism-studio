{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo phase5b conform probe: no web install",
  "buildCommand": "echo phase5b conform probe: no web build",
  "outputDirectory": "deploy/workers-staging/static",
  "daemons": {
    "conform": {
      "root": "./",
      "entrypoint": "Dockerfile.phase5b-conform",
      "instances": { "iad1": 1 },
      "resources": { "requests": { "memory": "1Gi" } },
      "terminationGracePeriodSeconds": 30,
      "livenessProbe": {
        "httpGet": { "port": 8080, "path": "/healthz" },
        "initialDelaySeconds": 20,
        "periodSeconds": 30,
        "timeoutSeconds": 5,
        "failureThreshold": 4
      }
    }
  }
}
